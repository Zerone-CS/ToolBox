# NPU Container Manager 配置文件示例
# 复制此文件为 config.env 并填入实际值

# ============================================
# Claude Code / Codex 可选配置
# ============================================
# 如果需要在容器内使用 Claude Code 或 Codex AI 编程助手，
# 请配置以下选项

# Node.js 安装路径（用于运行 Claude Code / Codex）
# 示例: /home/user/nodejs 或 /opt/nodejs
NODEJS_HOST_PATH=

# Anthropic API 配置（用于 Claude Code）
# 获取 API Key: https://console.anthropic.com/
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=

# Codex API 配置（如果使用 Codex）
CODEX_API_KEY=

# ============================================
# 注意事项
# ============================================
# 1. 此文件包含敏感信息，已被 .gitignore 排除，不会提交到 Git
# 2. 如果不需要 Claude Code / Codex 支持，可以留空或删除此文件
# 3. API Key 请妥善保管，不要分享给他人
